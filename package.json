{
  "name": "stillspace-gesture-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:camera": "node scripts/camera-qa.mjs",
    "test:lifecycle": "node scripts/lifecycle-qa.mjs",
    "test:session": "node scripts/session-qa.mjs",
    "test:resilience": "node scripts/resilience-qa.mjs",
    "test:touch": "node scripts/touch-qa.mjs",
    "test:space": "node scripts/space-qa.mjs",
    "check": "tsc --noEmit",
    "setup:assets": "node scripts/setup-assets.mjs && node scripts/setup-environments.mjs",
    "password": "node scripts/password.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "ali-oss": "6.23.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/ali-oss": "6.23.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
