# Place inside your TLS-enabled server block; replace host/certificate settings.
# APP_ORIGIN must be the exact public HTTPS origin; TRUST_PROXY=1.
location / {
    proxy_pass http://127.0.0.1:3188;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    client_max_body_size 32k;
}
# Photo bytes go directly to OSS; the Node API receives small JSON only.
