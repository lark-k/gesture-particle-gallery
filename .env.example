PORT=3188
NODE_ENV=development
APP_ORIGIN=http://localhost:5188
DATABASE_PATH=./data/gallery.sqlite
# Development only: leave credentials empty for local session-only uploads.
# Production requires OSS. Keep actual credentials only in .env or server environment.
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional short-lived credential supplied by your deployment platform.
OSS_STS_TOKEN=
# In cloud mode: npm run password -- "a-long-unique-password"; paste salt:hash below.
ADMIN_USERNAME=curator
ADMIN_PASSWORD_HASH=
# Production registration requires this invite; blank disables new registrations.
REGISTRATION_INVITE_CODE=
# Development only. Set false when exposing a dev server to other people.
DEV_OPEN_REGISTRATION=true
MAX_UPLOAD_MB=20
MAX_PHOTOS=120
# Enable only behind exactly one trusted reverse proxy (needed for rate limiting).
TRUST_PROXY=0
